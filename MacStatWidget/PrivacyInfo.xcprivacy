<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for MacStatWidgetExtension (the iOS home/lock screen
  widget). Bundled only into the *iOS* extension — project.yml excludes this
  file from `MacStatWidgetExtension_macOS`, which shares this source
  directory but ships Developer ID rather than through App Store Connect and
  whose UserDefaults suite is a plain named suite rather than an App Group
  (see `WidgetSnapshotStore.macSuiteIdentifier`), so neither of the two
  UserDefaults reasons below would describe it truthfully.

  App Store Connect scans every binary in the uploaded app, extensions
  included, so an appex that uses a required-reason API needs its own
  declaration. Two things end up in this bundle: the four Swift files under
  MacStatWidget/, and a copy of MacStatKit.framework (project.yml gives this
  target `MacStatKit_iOS` with `embed: true`). The entries below cover both,
  and say which is which.

  Reason-code text quoted below comes from Apple's
  "NSPrivacyAccessedAPITypeReasons" documentation:
  https://developer.apple.com/documentation/bundleresources/app-privacy-configuration/nsprivacyaccessedapitypes/nsprivacyaccessedapitypereasons
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<!--
	  A widget timeline provider that opens no socket. `Provider.swift` reads
	  one App Group key and renders it; there is no network code in this
	  bundle's own sources at all.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Nothing. `WidgetSnapshot` (MacStatKit/Sync/WidgetSnapshot.swift) carries
	  a device name, timestamps, battery percent/charging flags, CPU percent,
	  memory fraction, sleep-assertion state and a short battery history —
	  facts about the user's own Mac, read from a container on the user's own
	  phone, drawn on the user's own home screen. No location field exists on
	  `WidgetSnapshot`; the Location Log never reaches this extension.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<!--
			  1C8F.1 — "Declare this reason to access user defaults to read
			  and write information only accessible to the apps, app
			  extensions, and App Clips that are members of the same App
			  Group as the app itself."
			  Evidence, and the whole reason this extension exists:
			  `WidgetSnapshotStore.read()`
			  (MacStatKit/Sync/WidgetSnapshot.swift) opens
			  `UserDefaults(suiteName: "group.dev.malekswilam.macstat")` — the
			  group in MacStatWidget/MacStatWidget.entitlements — and is
			  called from both `snapshot(for:in:)` and `timeline(for:in:)` in
			  MacStatWidget/Provider.swift. The phone app writes, this
			  extension reads, and nothing outside the group is touched.

			  CA92.1 — "Declare this reason to access user defaults to read
			  and write information that is only accessible to the app
			  itself."
			  Declared because the embedded MacStatKit.framework binary
			  contains `UserDefaults.standard` call sites — `RollupJob`
			  (MacStatKit/Persistence/RollupJob.swift) and
			  `PendingAlertPushStore`
			  (MacStatKit/Sync/PendingAlertPushStore.swift), both of whose
			  default initializers take `.standard`. Neither type is ever
			  constructed by this extension (their only production callers are
			  in MacStat/App/AppDelegate.swift, the Mac app), but the symbols
			  ship inside this appex and Apple's check is a static scan of the
			  binaries, not of the call graph. Declaring what is in the bundle
			  is the accurate statement; the narrower claim "this extension
			  never reads standard defaults" is recorded here rather than by
			  omitting a category the scanner will find.
			-->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<!--
			  35F9.1 — "Declare this reason to access the system boot time in
			  order to measure the amount of time that has elapsed between
			  events that occurred within the app or to perform calculation to
			  enable timers. Information accessed for this reason, or any
			  derived information, may not be sent off-device."
			  Same situation as CA92.1 above: `ProcessInfo.processInfo
			  .systemUptime` lives in MacStatKit/Insights/DeviceFacts.swift,
			  which is compiled into the MacStatKit.framework copy embedded
			  here. No code in MacStatWidget/ calls it, and this extension
			  sends nothing off-device at all.
			-->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!--
		  Absent for the same audited reasons as the phone app's manifest:
		  no disk-space API (`volumeAvailableCapacity*`, `statfs`), no file
		  timestamp read, no `UITextInputMode.activeInputModes` anywhere in
		  this bundle.
		-->
	</array>
</dict>
</plist>
