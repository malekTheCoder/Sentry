# Xcode
# Project is generated by XcodeGen from project.yml (source of truth) —
# run `xcodegen generate` after cloning or after editing project.yml.
build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Secrets / local config
*.xcconfig.local
.env

# Claude Code local state (worktrees, agent scratch files) — never shared
.claude/

# Parallel-development worktrees. `git worktree add worktrees/<name>` puts a
# whole second checkout here; a plain `git add -A` from the repo root would
# otherwise stage each one as an embedded git repository, which git accepts
# with only a warning and which produces a commit nobody can clone.
worktrees/

# Release staging: DMGs and the generated appcast.xml. The published copy of
# appcast.xml lives on the gh-pages branch; this directory is scratch space
# that release.sh fetches into and regenerates.
dist/
