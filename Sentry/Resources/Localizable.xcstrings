{
  "sourceLanguage": "en",
  "strings": {
    "\"Require confirmation\" shows a native dialog in Sentry before the action runs, every time — the agent's call is paused until you allow or deny it.": {},
    "%@": {},
    "%@\n\nDetails: %@\n\nThis was requested over MCP by an AI agent connected to Sentry. Allow it?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nDetails: %2$@\n\nThis was requested over MCP by an AI agent connected to Sentry. Allow it?"
          }
        }
      }
    },
